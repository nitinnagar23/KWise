rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getStaffDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/staff/$(request.auth.uid));
    }

    function isApprovedActiveStaff(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/staff/$(request.auth.uid)) &&
             getStaffDoc(userId).data.get('isActive', true) != false &&
             (getStaffDoc(userId).data.get('isApproved', false) == true ||
              getStaffDoc(userId).data.get('status', 'PENDING') == 'APPROVED');
    }

    function isStaffMember(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        isApprovedActiveStaff(userId)
      );
    }

    function getStaffRole(userId) {
      return request.auth.uid == userId
        ? 'ADMINISTRATOR'
        : (isApprovedActiveStaff(userId)
            ? getStaffDoc(userId).data.role
            : 'NONE');
    }

    function isAdmin(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        getStaffRole(userId) == 'ADMINISTRATOR'
      );
    }

    function isAdminOrManager(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        getStaffRole(userId) == 'ADMINISTRATOR' ||
        getStaffRole(userId) == 'MANAGER'
      );
    }

    function isNonAnonymous() {
      return isAuthenticated() &&
             request.auth.token.get('firebase', {}).get('sign_in_provider', 'google.com') != 'anonymous';
    }

    function isValidUser(data) {
      return (('storeName' in data && data.storeName is string && data.storeName.size() > 0 && data.storeName.size() <= 100) ||
              ('shopName' in data && data.shopName is string && data.shopName.size() > 0 && data.shopName.size() <= 100));
    }

    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('village' in data) || (data.village is string && data.village.size() <= 100)) &&
             (!('creditLimit' in data) || (data.creditLimit is number && data.creditLimit >= 0 && data.creditLimit <= 100000000)) &&
             (!('currentBalance' in data) || (data.currentBalance is number && data.currentBalance >= -100000000 && data.currentBalance <= 100000000)) &&
             (!('totalUdhari' in data) || (data.totalUdhari is number && data.totalUdhari >= -100000000 && data.totalUdhari <= 100000000));
    }

    function isValidTransaction(data) {
      return data.customerId is string && data.customerId.size() > 0 && data.customerId.size() <= 128 &&
             data.type is string && data.type.size() > 0 && data.type.size() <= 50 &&
             data.amount is number && data.amount >= 0 && data.amount <= 100000000 &&
             (!('totalSalePrice' in data) || (data.totalSalePrice is number && data.totalSalePrice >= 0 && data.totalSalePrice <= 100000000)) &&
             (!('paidAmount' in data) || (data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= 100000000)) &&
             (!('udhariAmount' in data) || (data.udhariAmount is number && data.udhariAmount >= 0 && data.udhariAmount <= 100000000));
    }

    function isValidInventory(data) {
      return (('name' in data && data.name is string && data.name.size() > 0 && data.name.size() <= 150) ||
              ('feedName' in data && data.feedName is string && data.feedName.size() > 0 && data.feedName.size() <= 150)) &&
             (!('stockBags' in data) || (data.stockBags is number && data.stockBags <= 1000000)) &&
             (!('stockLooseKg' in data) || (data.stockLooseKg is number && data.stockLooseKg <= 50000000)) &&
             (!('currentStockKg' in data) || (data.currentStockKg is number && data.currentStockKg <= 50000000));
    }

    function isValidBill(data) {
      return data.customerId is string && data.customerId.size() > 0 && data.customerId.size() <= 128 &&
             data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 100000000;
    }

    function isValidSupplier(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('balance' in data) || (data.balance is number && data.balance >= -100000000 && data.balance <= 100000000));
    }

    function isValidAuditLog(data) {
      return data.saleId is string && data.saleId.size() > 0 && data.saleId.size() <= 128 &&
             data.actionType is string && data.actionType.size() > 0 && data.actionType.size() <= 32;
    }

    function isValidPairingToken(data, code) {
      return data.code is string && data.code.size() >= 8 && data.code.size() <= 12 &&
             data.code == code &&
             data.adminUid is string && data.adminUid.size() > 0 &&
             data.storeName is string && data.storeName.size() > 0 && data.storeName.size() <= 100 &&
             data.assignedRole is string && data.assignedRole in ['CASHIER', 'MANAGER', 'STAFF'] &&
             data.status == 'ACTIVE' &&
             data.expiresAt is number &&
             data.expiresAt > request.time.toMillis() - 5 * 60 * 1000 &&
             data.expiresAt <= request.time.toMillis() + 20 * 60 * 1000;
    }

    function hasValidClaimedPairing(userId, staffId, data) {
      return 'pairingCode' in data &&
             data.pairingCode is string &&
             data.pairingCode.size() >= 8 &&
             data.pairingCode.size() <= 12 &&
             exists(/databases/$(database)/documents/pairings/$(data.pairingCode)) &&
             get(/databases/$(database)/documents/pairings/$(data.pairingCode)).data.status == 'CLAIMED' &&
             get(/databases/$(database)/documents/pairings/$(data.pairingCode)).data.claimedByUid == staffId &&
             get(/databases/$(database)/documents/pairings/$(data.pairingCode)).data.adminUid == userId &&
             get(/databases/$(database)/documents/pairings/$(data.pairingCode)).data.assignedRole == data.get('role', 'CASHIER') &&
             get(/databases/$(database)/documents/pairings/$(data.pairingCode)).data.expiresAt > request.time.toMillis();
    }

    function isValidSelfPairedStaffDoc(userId, staffId, data) {
      return data.keys().hasOnly([
               'staffUid', 'name', 'email', 'deviceInfo', 'role', 'pairingCode',
               'isActive', 'isApproved', 'status', 'pairedAt', 'lastActiveAt', 'updatedAt'
             ]) &&
             'staffUid' in data && data.staffUid == staffId &&
             'role' in data && data.role in ['CASHIER', 'MANAGER', 'STAFF'] &&
             'isActive' in data && data.isActive == true &&
             'isApproved' in data && data.isApproved == false &&
             'status' in data && data.status == 'PENDING' &&
             'pairedAt' in data && data.pairedAt is number &&
             hasValidClaimedPairing(userId, staffId, data);
    }

    match /users/{userId} {
      allow read: if isStaffMember(userId);
      allow write: if isAdmin(userId) && (request.method != 'create' && request.method != 'update' || isValidUser(request.resource.data));

      match /customers/{customerId} {
        allow read: if isStaffMember(userId);
        allow create: if isStaffMember(userId) &&
                         isValidCustomer(request.resource.data) &&
                         (isAdmin(userId) || request.resource.data.get('creditLimit', 0) <= 10000);
        allow update: if isStaffMember(userId) &&
                         isValidCustomer(request.resource.data) &&
                         (isAdmin(userId) ||
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creditLimit', 'isDeleted']));
        allow delete: if isAdminOrManager(userId);
      }

      match /transactions/{txId} {
        allow read: if isStaffMember(userId);
        allow create: if isStaffMember(userId) && isValidTransaction(request.resource.data);
        allow update: if isAdminOrManager(userId) && isValidTransaction(request.resource.data);
        allow delete: if isAdminOrManager(userId);
      }

      match /inventory/{itemId} {
        allow read: if isStaffMember(userId);
        allow create: if isAdminOrManager(userId) && isValidInventory(request.resource.data);
        allow update: if isStaffMember(userId) &&
                         isValidInventory(request.resource.data) &&
                         (isAdminOrManager(userId) ||
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                            'sellingPricePerKg', 'salePricePerKg', 'looseSellingPricePerKg',
                            'averagePurchaseCostPerKg', 'name', 'feedName', 'kgPerBag', 'isDeleted'
                          ]));
        allow delete: if isAdminOrManager(userId);
      }

      match /bills/{billId} {
        allow read: if isStaffMember(userId);
        allow create: if isStaffMember(userId) && isValidBill(request.resource.data);
        allow update, delete: if isAdminOrManager(userId) && (request.method == 'delete' || isValidBill(request.resource.data));
      }

      match /suppliers/{supplierId} {
        allow read, write: if isAdminOrManager(userId) && (request.method != 'create' && request.method != 'update' || isValidSupplier(request.resource.data));
      }

      match /audit_logs/{logId} {
        allow read: if isStaffMember(userId);
        allow create: if isStaffMember(userId) && isValidAuditLog(request.resource.data);
        allow update, delete: if false;
      }

      match /staff/{staffId} {
        allow read: if isStaffMember(userId) || (isAuthenticated() && request.auth.uid == staffId);
        allow create: if isAdmin(userId) || (
          isNonAnonymous() &&
          request.auth.uid == staffId &&
          isValidSelfPairedStaffDoc(userId, staffId, request.resource.data)
        );
        allow update: if isAdmin(userId) || (
          isNonAnonymous() &&
          request.auth.uid == staffId && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastActiveAt', 'deviceInfo', 'name', 'email', 'updatedAt', 'pairedAt']) ||
            (
              request.resource.data.pairingCode != resource.data.get('pairingCode', '') &&
              isValidSelfPairedStaffDoc(userId, staffId, request.resource.data)
            )
          )
        );
        allow delete: if isAdmin(userId) || (isAuthenticated() && request.auth.uid == staffId);
      }
    }

    match /pairings/{code} {
      allow create: if isNonAnonymous() &&
                       request.auth.uid == request.resource.data.adminUid &&
                       isValidPairingToken(request.resource.data, code);

      allow delete: if isAuthenticated() && resource.data.adminUid == request.auth.uid;

      allow get: if isNonAnonymous() && (
                    resource == null ||
                    (resource.data.status == 'ACTIVE' && request.time.toMillis() < resource.data.expiresAt) ||
                    resource.data.adminUid == request.auth.uid ||
                    resource.data.claimedByUid == request.auth.uid
                  );

      allow list: if isAuthenticated() && resource.data.adminUid == request.auth.uid;

      allow update: if isNonAnonymous() && (
        resource.data.adminUid == request.auth.uid ||
        (resource.data.status == 'ACTIVE' &&
         request.time.toMillis() < resource.data.expiresAt &&
         request.resource.data.status == 'CLAIMED' &&
         request.resource.data.claimedByUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'claimedByUid', 'claimedByName', 'claimedByEmail', 'claimedAt'])) ||
        (resource.data.status == 'CLAIMED' &&
         resource.data.claimedByUid == request.auth.uid &&
         request.resource.data.status == 'USED' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'usedAt']))
      );
    }
  }
}

